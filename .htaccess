# ── Страница ошибки ──
ErrorDocument 404 /404.html

# ── Без www (HTTPS-редирект настраивается в панели хостинга) ──
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.ag-pg\.ru$ [NC]
  RewriteRule ^(.*)$ https://ag-pg.ru/$1 [R=301,L]
</IfModule>

# ── Сжатие ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# ── Кэш статики ──
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

AddDefaultCharset UTF-8

# ── Файлы, которые меняются из админки ──
# Хостинг по умолчанию кеширует .js на 45 дней. Для данных это недопустимо:
# бюро сохраняет правку, а посетитель видит старое содержимое неделями.
<FilesMatch "-data\.js$">
  <IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 5 minutes"
  </IfModule>
  <IfModule mod_headers.c>
    Header set Cache-Control "max-age=300, must-revalidate"
  </IfModule>
</FilesMatch>

# Скрипт эффектов правится редко, но обновление должно доходить за час, а не за месяц
<FilesMatch "^effects\.js$">
  <IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 hour"
  </IfModule>
  <IfModule mod_headers.c>
    Header set Cache-Control "max-age=3600, must-revalidate"
  </IfModule>
</FilesMatch>
